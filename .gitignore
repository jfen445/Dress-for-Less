# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
dist/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts is deliberately NOT ignored. It is what pulls in
# next/image-types/global, which declares *.png/*.jpg as modules — without it
# `tsc --noEmit` fails on every `import logo from "../../public/dfl-logo.png"`.
# Next regenerates it on dev/build, so it exists locally either way; CI only
# runs tsc, so it has to come from the repo.

pages/preview/

